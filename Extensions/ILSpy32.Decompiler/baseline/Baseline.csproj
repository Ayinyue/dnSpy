<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>baseline</AssemblyName>
    <RootNamespace>EngineBaseline</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The probe/ subfolder is its own project (the double-engine verification
         harness); its sources must not leak into this compilation. -->
    <Compile Remove="probe\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- dnSpy decompiler contracts (IDecompiler, IDecompilerOutput) + dnlib.
         Engine assemblies are NOT referenced at compile time: the two engine
         generations are loaded by path at runtime so they can be compared in
         separate processes without type identity conflicts. -->
    <Reference Include="dnSpy.Contracts.Logic">
      <HintPath>..\..\..\dnSpy\dnSpy\bin\Release\net11.0-windows\dnSpy.Contracts.Logic.dll</HintPath>
    </Reference>
    <Reference Include="dnlib">
      <HintPath>..\..\..\dnSpy\dnSpy\bin\Release\net11.0-windows\dnlib.dll</HintPath>
    </Reference>
    <!-- Roslyn: syntax-only validation of the dumped output. -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>..\..\..\dnSpy\dnSpy\bin\Release\net11.0-windows\Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.VisualBasic">
      <HintPath>..\..\..\dnSpy\dnSpy\bin\Release\net11.0-windows\Microsoft.CodeAnalysis.VisualBasic.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>..\..\..\dnSpy\dnSpy\bin\Release\net11.0-windows\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- dnSpy's output decompiles WPF-heavy UI assemblies, so the semantic compile
         needs the WindowsDesktop shared framework (PresentationCore, ...). Relying
         on the process TPA is non-deterministic: a run without it measured dnSpy.dll
         at 1710 realBadFiles instead of 1068 purely from missing references. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
