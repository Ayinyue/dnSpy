<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The dump modes write decompiled .cs/.vb files into subfolders of this project;
         they must never be picked up as sources. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The 2.3 core assembly (and the settings pages) reference WPF. -->
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SettingsMigrationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 2.3 引擎按名称引用 dnlib 4.5.0.0。干净构建的 dnSpy bin 里没有 dnlib.dll
         （本地那份是历史遗留），AssemblyResolve 目录也就找不到它 —— CI 上
         lang-diff / corpus 门全部崩在 FileNotFoundException。probe 自带一份即可，
         版本与 dnSpy 的 $(DnlibVersion) 一致。 -->
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 其余引用仍是 compile-only (Private=false)：运行时经 AssemblyResolve 指向
         权威的 dnSpy bin，避免 app base 里的陈旧副本静默胜出。 -->
    <Reference Include="dnSpy.Contracts.Logic">
      <HintPath>..\..\..\..\dnSpy\dnSpy\bin\Release\net10.0-windows\dnSpy.Contracts.Logic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="dnSpy.Decompiler.ILSpy32.x">
      <HintPath>..\..\..\..\dnSpy\dnSpy\bin\Release\net10.0-windows\dnSpy.Decompiler.ILSpy32.x.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="dnSpy.Contracts.DnSpy">
      <HintPath>..\..\..\..\dnSpy\dnSpy\bin\Release\net10.0-windows\dnSpy.Contracts.DnSpy.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\..\..\..\dnSpy\dnSpy\bin\Release\net10.0-windows\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
