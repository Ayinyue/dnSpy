<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:settings="clr-namespace:dnSpy.Decompiler.ILSpy32.Settings"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One row per IDecompilerOption. The 3.2 settings pages bind their page's Settings.Options
        collection; bool options get a checkbox, other types (e.g. the IL MaxStringLength int
        option) get a text box. The option's Description is the label / tooltip.
    -->
    <DataTemplate x:Key="DecompilerOption32ItemTemplate">
        <Grid Margin="0 5 0 0">
            <CheckBox x:Name="booleanOption" Content="{Binding Description}" IsChecked="{Binding Value}" ToolTip="{Binding Description}"/>
            <TextBox x:Name="valueOption" Text="{Binding Value}" Visibility="Collapsed" ToolTip="{Binding Description}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Type.Name}" Value="Int32">
                <Setter TargetName="booleanOption" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="valueOption" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings:CSharpDecompilerSettingsPage32}">
        <StackPanel Margin="5">
            <ItemsControl ItemsSource="{Binding Settings.Options}" ItemTemplate="{StaticResource DecompilerOption32ItemTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings:VbDecompilerSettingsPage32}">
        <StackPanel Margin="5">
            <ItemsControl ItemsSource="{Binding Settings.Options}" ItemTemplate="{StaticResource DecompilerOption32ItemTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings:ILDecompilerSettingsPage32}">
        <StackPanel Margin="5">
            <ItemsControl ItemsSource="{Binding Settings.Options}" ItemTemplate="{StaticResource DecompilerOption32ItemTemplate}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
