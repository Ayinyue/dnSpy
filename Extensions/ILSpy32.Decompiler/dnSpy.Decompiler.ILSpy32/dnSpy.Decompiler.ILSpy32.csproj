<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <Import Project="..\..\..\DnSpyCommon.props" />

  <PropertyGroup>
    <Copyright>$(DnSpyAssemblyCopyright)</Copyright>
    <Version>$(DnSpyAssemblyVersion)</Version>
    <InformationalVersion>$(DnSpyAssemblyInformationalVersion)</InformationalVersion>

    <AssemblyName>dnSpy.Decompiler.ILSpy32.x</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\dnSpy.snk</AssemblyOriginatorKeyFile>
    <OutputPath>..\..\..\dnSpy\dnSpy\bin\$(Configuration)\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- The VB converter is compiled by default. Set -p:EnableILSpy32VB=false to
         exclude it (e.g. while iterating on the C# path only). -->
    <EnableILSpy32VB>true</EnableILSpy32VB>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="VisualBasic\**\*.cs" Condition=" '$(EnableILSpy32VB)' != 'true' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\dnSpy\dnSpy.Contracts.DnSpy\dnSpy.Contracts.DnSpy.csproj" />
    <ProjectReference Include="..\..\..\dnSpy\dnSpy.Contracts.Logic\dnSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\..\..\dnSpy\dnSpy.Decompiler\dnSpy.Decompiler.csproj" />
    <!-- Pin the referenced TFM: build.ps1 passes -f net10.0-windows, and that global property
         would otherwise be handed to this netstandard2.0-only project. -->
    <ProjectReference Include="..\ICSharpCode.Decompiler\ICSharpCode.Decompiler\ICSharpCode.Decompiler.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- VB AST + OutputVisitor + IOutputFormatter, compiled without the old engine. -->
    <ProjectReference Include="..\ICSharpCode.NRefactory.VB32\ICSharpCode.NRefactory.VB32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <!-- In-repo copy next to the engine csproj; the external ILSPY\ILSPY clone is not
           available on CI, and the dnSpy bin output does not exist on a clean build. -->
      <HintPath>$(MSBuildThisFileDirectory)..\ICSharpCode.Decompiler\ICSharpCode.Decompiler\lib\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
