<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <Import Project="..\..\DnSpyCommon.props" />

  <PropertyGroup>
    <Copyright>$(DnSpyAssemblyCopyright)</Copyright>
    <Version>$(DnSpyAssemblyVersion)</Version>
    <InformationalVersion>$(DnSpyAssemblyInformationalVersion)</InformationalVersion>

    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\dnSpy.snk</AssemblyOriginatorKeyFile>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>

    <RuntimeIdentifiers>$(DnSpyRuntimeIdentifiers)</RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Images\dnSpy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <Choose>
    <!-- Use the x86 icon when publishing the .NET x86 build -->
    <When Condition="'$(RuntimeIdentifier)' == 'win-x86' And '$(IsDotNetFramework)' == 'false'">
      <PropertyGroup>
        <ApplicationIcon>Images\dnSpy-x86.ico</ApplicationIcon>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <ApplicationIcon>Images\dnSpy.ico</ApplicationIcon>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <Compile Remove="MainApp\DevBuildWarning.cs" />
    <None Include="MainApp\DevBuildWarning.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnSpy.Contracts.Debugger.DotNet\dnSpy.Contracts.Debugger.DotNet.csproj" />
    <ProjectReference Include="..\dnSpy.Contracts.Debugger\dnSpy.Contracts.Debugger.csproj" />
    <ProjectReference Include="..\dnSpy.Contracts.DnSpy\dnSpy.Contracts.DnSpy.csproj" />
    <ProjectReference Include="..\dnSpy.Contracts.Logic\dnSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\dnSpy.Images\dnSpy.Images.csproj" />
    <ProjectReference Include="..\Roslyn\dnSpy.Roslyn.CSharp.EditorFeatures\dnSpy.Roslyn.CSharp.EditorFeatures.csproj" />
    <ProjectReference Include="..\Roslyn\dnSpy.Roslyn.EditorFeatures\dnSpy.Roslyn.EditorFeatures.csproj" />
    <ProjectReference Include="..\Roslyn\dnSpy.Roslyn\dnSpy.Roslyn.csproj" />
    <ProjectReference Include="..\dnSpy.Decompiler\dnSpy.Decompiler.csproj" />
    <ProjectReference Include="..\..\Libraries\ICSharpCode.TreeView\ICSharpCode.TreeView.csproj" />
    <ProjectReference Include="..\Roslyn\dnSpy.Roslyn.VisualBasic.EditorFeatures\dnSpy.Roslyn.VisualBasic.EditorFeatures.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\dnSpy.ico" />
    <EmbeddedResource Include="LicenseInfo\CREDITS.txt" />
    <None Remove="app.config" Condition=" '$(IsDotNetFramework)' != 'true' " />
    <None Include="app.manifest" />
    <None Include="Themes\*.dntheme">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="FileLists\*.FileList.xml;LicenseInfo\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\dnSpy.Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>dnSpy.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\dnSpy.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>dnSpy.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition=" '$(IsDotNetFramework)' == 'true' ">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationFramework.Aero" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="$(IcedVersion)" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" Version="$(MSVSCompositionVersion)" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" Version="$(MSVSIntellisenseVersion)" />
    <!-- Self contained .NET apps already ship with this DLL (not necessarily the same version, though) -->
    <PackageReference Include="Microsoft.DiaSymReader.Native" Version="$(DiaSymReaderVersion)" Condition=" '$(IsSelfContainedDotNet)' != 'true' " />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="$(MSVSTextVersion)" />
  </ItemGroup>


  <!--
    Copy ALL extension DLLs to the publish output directory. Extensions are built via <MSBuild>,
    NOT as ProjectReferences, so dotnet publish does not copy them automatically; without this the
    published app has no decompiler extensions (*.x.dll) and no debug\*.ex.xml, which breaks the
    Exception Settings window.
  -->
  <Target Name="CopyDecompilerExtensionToPublishDir" AfterTargets="Publish">
    <PropertyGroup>
      <RIDSubDir Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)\</RIDSubDir>
      <RIDSubDir Condition="'$(RuntimeIdentifier)' == ''"></RIDSubDir>
      <!-- Extensions built by BuildDecompilerExtension have no RID, so most of them live in the
           base output dir. Only projects in the dnSpy graph also have a RID subfolder; copy the
           base dir first and let the RID copies overwrite duplicates. -->
      <ExtBaseDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</ExtBaseDir>
      <ExtSourceDir>$(ExtBaseDir)$(RIDSubDir)</ExtSourceDir>
      <DecompilerExtDir>$(MSBuildProjectDirectory)\..\..\Extensions\ILSpy.Decompiler\</DecompilerExtDir>
      <DecompilerBinDir>$(DecompilerExtDir)ICSharpCode.Decompiler\ICSharpCode.Decompiler\bin\$(Configuration)\$(TargetFramework)\$(RIDSubDir)</DecompilerBinDir>
      <CoreBinDir>$(DecompilerExtDir)dnSpy.Decompiler.ILSpy.Core\bin\$(Configuration)\$(TargetFramework)\$(RIDSubDir)</CoreBinDir>
      <NRefactoryBinDir>$(DecompilerExtDir)NRefactory\ICSharpCode.NRefactory\bin\$(Configuration)\$(TargetFramework)\$(RIDSubDir)</NRefactoryBinDir>
      <NRefactoryCSharpBinDir>$(DecompilerExtDir)NRefactory\ICSharpCode.NRefactory.CSharp\bin\$(Configuration)\$(TargetFramework)\$(RIDSubDir)</NRefactoryCSharpBinDir>
      <NRefactoryVBBinDir>$(DecompilerExtDir)ICSharpCode.Decompiler\NRefactory.VB\ICSharpCode.NRefactory.VB\bin\$(Configuration)\$(TargetFramework)\$(RIDSubDir)</NRefactoryVBBinDir>
      <!-- ILSpy 3.2 engine is netstandard2.0 and lives next to the extension outputs. -->
      <Ilspy32EngineDir>$(MSBuildProjectDirectory)\..\..\Extensions\ILSpy32.Decompiler\ICSharpCode.Decompiler\ICSharpCode.Decompiler\bin\$(Configuration)\netstandard2.0\</Ilspy32EngineDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Extension DLLs built without a RID live only in the base output dir. -->
      <ExtensionBaseFiles Include="$(ExtBaseDir)*.x.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)*.x.deps.json" />
      <!-- Satellite resource assemblies of the extensions copied below (`**` keeps %(RecursiveDir)). -->
      <ExtensionSatelliteFiles Include="$(ExtBaseDir)**\dnSpy.*.x.resources.dll" />
      <ExtensionSatelliteFiles Remove="$(ExtBaseDir)win-x86\**\dnSpy.*.x.resources.dll" />
      <ExtensionSatelliteFiles Remove="$(ExtBaseDir)win-x64\**\dnSpy.*.x.resources.dll" />
      <!-- Dependencies of the extensions above; they also live in the base output dir. -->
      <ExtensionBaseFiles Include="$(ExtBaseDir)dnSpy.Contracts.Debugger.DotNet.CorDebug.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)dnSpy.Contracts.Debugger.DotNet.Mono.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)dnSpy.Debugger.DotNet.Interpreter.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)Microsoft.CodeAnalysis.CSharp.Scripting.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)Microsoft.Diagnostics.Runtime.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)Mono.Debugger.Soft.dll" />
      <!-- Both decompiler engines. -->
      <ExtensionBaseFiles Include="$(ExtBaseDir)ICSharpCode.Decompiler.dll" />
      <ExtensionBaseFiles Include="$(ExtBaseDir)ILSpy32.Decompiler.dll" />
      <!-- Exception definition XML files (Exception Settings window reads bin\debug\*.ex.xml). -->
      <ExtensionDebugFiles Include="$(ExtBaseDir)debug\**\*.ex.xml" />
      <!-- RID-specific extension + decompiler DLLs. -->
      <ExtensionRidFiles Include="$(ExtSourceDir)*.x.dll" />
      <ExtensionRidFiles Include="$(ExtSourceDir)*.x.deps.json" />
      <ExtensionRidFiles Include="$(DecompilerBinDir)ICSharpCode.Decompiler.dll" />
      <ExtensionRidFiles Include="$(CoreBinDir)dnSpy.Decompiler.ILSpy.Core.dll" />
      <ExtensionRidFiles Include="$(NRefactoryBinDir)ICSharpCode.NRefactory.dll" />
      <ExtensionRidFiles Include="$(NRefactoryCSharpBinDir)ICSharpCode.NRefactory.CSharp.dll" />
      <ExtensionRidFiles Include="$(NRefactoryVBBinDir)ICSharpCode.NRefactory.VB.dll" />
      <ExtensionRidFiles Include="$(Ilspy32EngineDir)ILSpy32.Decompiler.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtensionBaseFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(ExtensionRidFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(ExtensionSatelliteFiles)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="false" Condition="Exists('%(Identity)')" />
    <Copy SourceFiles="@(ExtensionDebugFiles)" DestinationFolder="$(PublishDir)debug\%(RecursiveDir)" SkipUnchangedFiles="false" Condition="Exists('%(Identity)')" />
  </Target>

</Project>
